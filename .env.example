# Copy to .env (which is git-ignored) and fill in. Never commit real values.

# Password for the web app (username can be anything). Strongly recommended when hosted.
APP_PASSWORD=

# Free LLM via any OpenAI-compatible API. Default: Groq free tier (https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Alternatives:
# Google Gemini free tier: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
# Local Ollama (no key):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2

DB_PATH=data/ledger_checkup.db
